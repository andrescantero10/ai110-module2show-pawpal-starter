classDiagram
    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +mark_complete()
        +to_dict() dict
        +from_dict(data) Task
    }

    class Pet {
        +str name
        +str species
        +int age
        +list tasks
        +add_task(task)
        +remove_task(task)
        +get_tasks() list
        +task_count() int
        +to_dict() dict
        +from_dict(data) Pet
    }

    class Owner {
        +str name
        +list pets
        +add_pet(pet)
        +get_pet(name) Pet
        +get_all_tasks() list
        +save_to_json(path)
        +load_from_json(path) Owner
    }

    class Scheduler {
        +Owner owner
        +get_todays_schedule() list
        +sort_by_time(tasks) list
        +sort_by_priority_then_time(tasks) list
        +filter_tasks(pet_name, completed) list
        +detect_conflicts() list
        +find_next_available_slot(date, duration, start, end) str
        +mark_task_complete(task) Task
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : manages
